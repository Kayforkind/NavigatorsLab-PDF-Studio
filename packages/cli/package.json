{
  "name": "pdfstudio-cli",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "pdfstudio — command-line interface for PDF Studio: true in-place text editing, burned-in redaction, page ops. 100% local, no network.",
  "bin": {
    "pdfstudio": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "pdfstudio-core": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.7.2",
    "vitest": "^5.0.5"
  }
}
