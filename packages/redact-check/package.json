{
  "name": "pdfstudio-redact-check",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Browser-only checker for fake PDF redactions: finds solid black boxes and reports any text still hiding underneath them. Nothing is uploaded.",
  "scripts": {
    "dev": "vite --port 5200 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 5200 --strictPort",
    "fixtures": "node scripts/make-fixtures.mjs",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "typescript": "~5.7.2",
    "vite": "^6.4.3",
    "vitest": "^5.0.5"
  }
}
