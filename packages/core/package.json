{
  "name": "pdfstudio-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Node-safe PDF operations for PDF Studio: true content-stream text editing, vector redaction, page ops. No DOM, no network.",
  "main": "./dist/packages/core/src/index.js",
  "types": "./dist/packages/core/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/packages/core/src/index.d.ts",
      "default": "./dist/packages/core/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "typescript": "~5.7.2",
    "vitest": "^5.0.5"
  }
}
