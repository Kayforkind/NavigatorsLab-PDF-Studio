{
  "name": "pdf-studio",
  "private": false,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --port 5199 --strictPort",
    "build": "tsc -b && vite build && npm run docs:build",
    "build:pages": "vite build",
    "build:packages": "npm run build --workspaces --if-present",
    "deploy:pages": "npm run build && npx gh-pages -d dist -t true",
    "preview": "vite preview --port 5199 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:packages": "npm run test --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false",
    "docs:dev": "vitepress dev docs/site",
    "docs:build": "vitepress build docs/site && node scripts/build-docs.cjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84",
    "i18next": "^26.4.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.15",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "playwright": "^1.55.1",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.0"
  }
}